#!/usr/bin/env php
<?php

declare(strict_types=1);

use PhpTooling\Setup\Initializer;

$autoload = dirname(__DIR__, 3) . '/autoload.php';

if (!is_file($autoload)) {
    $autoload = dirname(__DIR__) . '/vendor/autoload.php';
}

if (!is_file($autoload)) {
    fwrite(STDERR, "Composer autoloader not found.\n");
    exit(1);
}

require $autoload;

$command = $argv[1] ?? null;

if ($command !== 'init') {
    fwrite(STDERR, "Usage: php-tooling init\n");
    exit(1);
}

try {
    $initializer = new Initializer();
    $initializer->run(getcwd());
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(1);
}
